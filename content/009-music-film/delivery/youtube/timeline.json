    },
    {
      "start": 41.96,
      "end": 54.1853125,
      "duration": 12.2253125,
      "sceneDuration": 12.505312499999999,
      "type": "speech",
      "id": "02",
      "speaker": "male",
      "scene": "interlude",
      "text": "شاید هم یه خاطره رو یادت میاره. هم صدا مهمه، هم اون چیزی که آهنگ یادت می‌اندازه. ولی جوابش برای همه یکی نیست. تو کجایی رو که می‌شنوی، اول چی میاد توی ذهنت؟",
      "voice": "voice-07",
      "approvedExactReuse": true
    },
    {
      "start": 54.465312499999996,
      "end": 64.98531249999999,
      "duration": 10.52,
      "sceneDuration": 10.799999999999999,
      "type": "speech",
      "id": "03",
      "speaker": "female",
      "scene": "sange-saboor",
      "text": "حالا سنگ صبور. این یکی رو با یه سؤال گوش کن؛ اگه شعرش رو نمی‌دونستی، باز همین حس رو ازش می‌گرفتی؟",
      "voice": "voice-06",
      "approvedExactReuse": false
    },
    {
      "start": 65.2653125,
      "end": 95.2653125,
      "duration": 30.0,
      "sceneDuration": 30.28,
      "type": "music",
      "scene": "sange-saboor",
      "title": "سنگ صبور",
      "artist": "محسن چاوشی",
      "sourceFile": "Mohsen Chavoshi - Sange Saboor [128].mp3",
      "sourceStart": 40,
      "cameraCutsLocal": [
        0.0,
        7.5200000000000005,
        14.94,
        22.56,
        30.0
      ]
