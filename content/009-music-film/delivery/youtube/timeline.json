      "id": "01",
      "speaker": "female",
      "scene": "opening",
      "text": "چرا بعضی آهنگا رو هر چقدر می‌شنویم، باز دلمون می‌خواد از اول پخششون کنیم؟ مثلاً کجایی؛ تو با صداش ارتباط می‌گیری یا با حرفی که می‌زنه؟",
      "voice": "voice-06",
      "approvedExactReuse": true
    },
    {
      "start": 11.68,
      "end": 41.68,
      "duration": 30.0,
      "sceneDuration": 30.28,
      "type": "music",
      "scene": "kojaei",
      "title": "کجایی",
      "artist": "محسن چاوشی و سینا سرلک",
      "sourceFile": "Mohsen Chavoshi , Sina Sarlak - Kojaei [128].mp3",
      "sourceStart": 45,
      "cameraCutsLocal": [
