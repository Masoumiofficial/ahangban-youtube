# Never commit real credentials. Copy this file to .env locally.
# Local-only binding. On a hosted server/container use HOST=0.0.0.0 instead.
HOST=127.0.0.1
PORT=3000
# Public, stable origin; no trailing path. For local development:
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
